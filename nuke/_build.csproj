<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace />
    <NoWarn>CS0649;CS0169</NoWarn>
    <FalloutRootDirectory>..</FalloutRootDirectory>
    <FalloutScriptDirectory>..\docs</FalloutScriptDirectory>
    <FalloutTelemetryVersion>1</FalloutTelemetryVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.5.0" />
    <PackageReference Include="Dangl.Fallout.WebDocu" Version="8.0.1" />
    <PackageReference Include="ReverseMarkdown" Version="4.6.0" />
  </ItemGroup>
</Project>
